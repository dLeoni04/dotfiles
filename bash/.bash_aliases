# Easy alias list
alias aliases="vim ~/.bash_aliases"

# Apt Packages Management
alias i="sudo apt install"
alias rem="sudo apt remove"
alias arem="sudo apt autoremove"
alias upg="sudo apt upgrade"
alias upd="sudo apt update"
alias iy="sudo apt install -y"
alias remy="sudo apt remove -y"
alias aremy="sudo apt autoremove -y"
alias upgy="sudo apt upgrade -y"
alias updy="sudo apt update -y"



alias mypython="cd /home/davide/Scrivania/qrcode_maker && source venv/bin/activate"

# TERMINAL APPLICATIONS

# Mpv
alias mpvf="mpv --fs"
alias mpva="mpv --no-audio"
alias mpvv="mpv --no-video"

#Ufw
alias fwe="sudo ufw enable"
alias fwd="sudo ufw disable"
alias fwal="sudo ufw allow"
alias fwden="sudo ufw deny"

# Micro Text Editor
alias micro="./micro"

# Wine Apps
alias arcade="wine /home/davide/Scrivania/ARCADE64_288_29052026/arcade64.exe"
alias cs="wine /home/davide/Scrivania/GIOCHI/Cave_Story_Italian_v2.0/Doukutsu.exe"
# Listing aliases
alias ll="ls -alh"
alias la="ls -A"

# Free and used space on my disks
alias dfh="df -h -x tmpfs"

# Directory changes
alias ..="cd .."

# Flatpak
alias artcraft="flatpak run ai.storyteller.artcraft-launcher"

# Stupid alias to experiment
alias hello="echo Ciao $USER, come butta? Spero tutto alla grande!"

