# Scelta del browser nel quale aprire gli articoli
browser "lynx %u"

# Comando per aprire i video YouTube con mpv, ma a me non funziona mai...
#macro w set browser "mpv %u" ; open-in-browser ; set browser "brave %u"
macro w set browser "mpv --ytdl-format='bestvideo[height<=480]+bestaudio/best[height<=480]' %u" ; open-in-browser ; set browser "brave %u"

# Refresh rules
refresh-on-startup yes
reload-threads 8

# Set Vim-like commands
unbind-key j
unbind-key k
unbind-key t
bind-key j down
bind-key k up
bind-key h quit
bind-key l open
bind-key ò select-tag
