# Scelta del browser nel quale aprire gli articoli
browser "lynx %u"

# Comando per aprire i video YouTube con mpv
#macro v set browser "mpv %u" ; open-in-browser ; set browser "brave %u"
macro v set browser "mpv %u" ; open-in-browser ; set browser "brave %u"


# Refresh rules
refresh-on-startup yes
reload-threads 8

# Set Vim-like commands
unbind-key j
unbind-key k
unbind-key t
bind-key j down
bind-key k up
bind-key h quit
bind-key l open
bind-key ò select-tag
